rules_version = '2';
// Scores are written by the browser (Spark has no Cloud Functions), so these rules are the anti-cheat:
// one game per write, at most 3 points and 32 Elo per game, at least 10 seconds between games.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function okName(n) { return n is string && n.size() >= 1 && n.size() <= 30; }
    function playerKeys() { return ['name', 'p', 'w', 'd', 'l', 'pts', 'elo', 'google', 'updated']; }
    function inc(n, o, k) { return n[k] is int && (n[k] == o[k] || n[k] == o[k] + 1); }
    // The result of one game decides which counter moves and how points and Elo may change.
    function oneGame(n, o) {
      return n.p == o.p + 1 && inc(n, o, 'w') && inc(n, o, 'd') && inc(n, o, 'l')
        && (n.w - o.w) + (n.d - o.d) + (n.l - o.l) == 1
        && n.pts is int && n.elo is int && n.elo - o.elo <= 32 && o.elo - n.elo <= 32
        && (n.w > o.w ? (n.pts - o.pts >= 1 && n.pts - o.pts <= 3 && n.elo >= o.elo)
          : n.d > o.d ? n.pts - o.pts == 1
          : n.pts == o.pts && n.elo <= o.elo);
    }

    match /players/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(playerKeys()) && request.resource.data.keys().hasAll(playerKeys())
        && okName(request.resource.data.name) && request.resource.data.google is bool
        && request.resource.data.updated == request.time
        && oneGame(request.resource.data, { 'p': 0, 'w': 0, 'd': 0, 'l': 0, 'pts': 0, 'elo': 1000 });
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(playerKeys())
        && okName(request.resource.data.name) && request.resource.data.updated == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updated'])
          || (request.resource.data.google is bool && request.time > resource.data.updated + duration.value(10, 's')
              && oneGame(request.resource.data, resource.data))
        );
      allow delete: if false;
    }

    match /games/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'opponent', 'level', 'result', 'reason', 'moves', 'minutes', 'at'])
        && request.resource.data.result in ['w', 'd', 'l'] && request.resource.data.at == request.time
        // Only together with the matching update of the player's totals (same batch).
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.updated == request.time;
      allow update, delete: if false;
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function google() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }

    // Owner accounts for the ?admin page. Added by hand in the Firebase console (document id = the account's uid).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Invites: invites/{new player's uid} = { ref: inviter's code }. Written once by the new player, only before
    // they have any score, and never for their own code. Public, so inviters can count their friends.
    match /invites/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ref', 'at'])
        && request.resource.data.ref is string && request.resource.data.ref.matches('[A-Za-z0-9]{8}')
        && !uid.matches(request.resource.data.ref + '.*')
        && request.resource.data.at == request.time
        && !exists(/databases/$(database)/documents/players/$(uid));
      allow update, delete: if false;
    }

    // Products a player recommends to the friends they invite, with their own Shopee affiliate link.
    // Only Google accounts can add them, every add or change waits for the owner's approval (status 'pending'),
    // and only approved ones are public.
    match /picks/{id} {
      function okPick(d) {
        return d.keys().hasOnly(['owner', 'ref', 'name', 'title', 'note', 'url', 'img', 'moods', 'status', 'at'])
          && d.owner == request.auth.uid && d.ref is string && d.ref.matches('[A-Za-z0-9]{8}') && request.auth.uid.matches(d.ref + '.*')
          && okName(d.name)
          && d.title is string && d.title.size() >= 2 && d.title.size() <= 60
          && d.note is string && d.note.size() <= 90
          && d.url is string && d.url.size() <= 300 && d.url.matches('https://(s[.]shopee[.]co[.]th|shope[.]ee|shopee[.]co[.]th)/[^ ]*')
          && d.img is string && d.img.size() <= 300 && (d.img == '' || d.img.matches('https://[a-z0-9.-]+[.]susercontent[.]com/[^ ]*'))
          && d.moods is list && d.moods.size() >= 1 && d.moods.size() <= 4 && d.moods.hasOnly(['tense', 'lost', 'won', 'learn'])
          && d.status == 'pending' && d.at == request.time;
      }
      allow read: if resource.data.status == 'ok' || (signedIn() && resource.data.owner == request.auth.uid) || isAdmin();
      allow create: if google() && okPick(request.resource.data);
      allow update: if (google() && resource.data.owner == request.auth.uid && okPick(request.resource.data))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pending', 'ok', 'no']);
      allow delete: if (signedIn() && resource.data.owner == request.auth.uid) || isAdmin();
    }

    // Who is behind each inviter's products: Google name and email, visible to the owner only (?admin).
    match /pickOwners/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if google() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'terms', 'at'])
        && request.resource.data.get('terms', 0) is int
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // Online rooms: the host creates rooms/{CODE}, one guest claims it, and only those two can send or read its messages.
    match /rooms/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{5}')
        && request.resource.data.keys().hasOnly(['host', 'guest', 'at'])
        && request.resource.data.host == request.auth.uid && request.resource.data.guest == null
        && request.resource.data.at == request.time;
      allow update: if signedIn() && resource.data.guest == null && resource.data.host != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest'])
        && request.resource.data.guest == request.auth.uid;
      allow delete: if false;

      match /msgs/{id} {
        function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
        allow read: if signedIn() && request.auth.uid in [room().host, room().guest];
        allow create: if signedIn() && request.auth.uid in [room().host, room().guest]
          && request.resource.data.keys().hasOnly(['to', 'n', 'd', 'from', 'at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.to in ['host', 'join']
          && request.resource.data.n is int && request.resource.data.d is map && request.resource.data.d.size() <= 8
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
